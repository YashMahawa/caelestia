#!/usr/bin/env bash
# Centralized launcher helper for optional applications with missing utility notification.
set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "Usage: caelestia-app-launch <command> [args...]" >&2
    exit 1
fi

cmd="$1"

if command -v "$cmd" &>/dev/null; then
    exec "$@"
else
    if command -v notify-send &>/dev/null; then
        notify-send -a "caelestia-cli" "Missing utility: $cmd" "Required binary '$cmd' is not installed."
    fi
    exit 1
fi
