#!/usr/bin/env python3
"""Safe multi-display control for the Caelestia dashboard and Nexus settings."""

from __future__ import annotations

import argparse
import json
import os
import re
import socket
import subprocess
import sys
import time
import uuid
from pathlib import Path


STATE_DIR = Path.home() / ".local/state/caelestia"
CONTROL_CONF = Path.home() / ".config/hypr/caelestia-display.conf"
MONITORS_CONF = Path.home() / ".config/hypr/monitors.conf"
HYPR_CONF = Path.home() / ".config/hypr/hyprland.conf"
VALID_NAME = re.compile(r"^[A-Za-z0-9_.:-]+$")
VALID_RESOLUTION = re.compile(r"^\d+x\d+@[\d.]+$")
VALID_POSITION = re.compile(r"^-?\d+x-?\d+$")
FALLBACK_WORKSPACE = "__caelestia_fallback"


def ensure_hypr_environment() -> None:
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    sockets = sorted(
        (runtime / "hypr").glob("*/.socket.sock"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    if sockets:
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sockets[0].parent.name


def run(args: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    if args and args[0] == "hyprctl":
        ensure_hypr_environment()
    return subprocess.run(args, text=True, capture_output=True, check=check, timeout=10)


def hypr_json(*args: str):
    return json.loads(run(["hyprctl", "-j", *args]).stdout)


def monitors() -> list[dict]:
    value = hypr_json("monitors", "all")
    return value if isinstance(value, list) else []


def workspaces() -> list[dict]:
    value = hypr_json("workspaces")
    return value if isinstance(value, list) else []


def connected_output_names() -> list[str]:
    """Return connected DRM connector names, including currently disabled outputs."""
    names: list[str] = []
    for status_file in Path("/sys/class/drm").glob("card*-*/status"):
        try:
            if status_file.read_text(encoding="utf-8").strip() != "connected":
                continue
        except OSError:
            continue
        name = re.sub(r"^card\d+-", "", status_file.parent.name)
        if VALID_NAME.fullmatch(name):
            names.append(name)
    return sorted(set(names))


def validate_name(name: str) -> str:
    if not VALID_NAME.fullmatch(name):
        raise ValueError("Invalid monitor name")
    return name


def internal_monitor(values: list[dict]) -> dict | None:
    return next((m for m in values if m["name"].startswith(("eDP-", "LVDS-", "DSI-"))), values[0] if values else None)


def external_monitors(values: list[dict]) -> list[dict]:
    internal = internal_monitor(values)
    return [m for m in values if internal is None or m["name"] != internal["name"]]


def output_names(values: list[dict]) -> list[str]:
    connected = connected_output_names()
    return connected or [validate_name(m["name"]) for m in values]


def internal_name(values: list[dict]) -> str:
    names = output_names(values)
    return next((name for name in names if name.startswith(("eDP-", "LVDS-", "DSI-"))), names[0] if names else "")


def external_names(values: list[dict]) -> list[str]:
    names = output_names(values)
    internal = internal_name(values)
    return [name for name in names if name != internal]


def option(name: str):
    try:
        value = hypr_json("getoption", name)
        if "int" in value:
            return value["int"]
        return value.get("str", "")
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return None


def status() -> int:
    values = monitors()
    focused = next((m for m in values if m.get("focused")), values[0] if values else None)
    default_monitor = option("cursor:default_monitor") or ""
    if default_monitor == "[[EMPTY]]":
        default_monitor = ""
    print(json.dumps({
        "monitors": values,
        "focused": focused["name"] if focused else "",
        "internal": internal_name(values),
        "external": external_names(values),
        "pointerFollowsMonitor": bool(option("misc:mouse_move_focuses_monitor")),
        "warpPointerWithWorkspace": int(option("cursor:warp_on_change_workspace") or 0) > 0,
        "defaultMonitor": default_monitor,
        "automaticSingleDisplay": True,
    }))
    return 0


def dispatch(command: str, value: str) -> None:
    result = run(["hyprctl", "dispatch", command, value])
    if "ok" not in result.stdout.lower():
        raise RuntimeError(result.stdout.strip() or result.stderr.strip())


def focus(name: str) -> int:
    name = validate_name(name)
    monitor = next((m for m in monitors() if m["name"] == name), None)
    if monitor is None:
        raise ValueError("Display is not connected")
    dispatch("focusmonitor", name)
    x = int(monitor["x"] + monitor["width"] / max(float(monitor.get("scale", 1)), 0.25) / 2)
    y = int(monitor["y"] + monitor["height"] / max(float(monitor.get("scale", 1)), 0.25) / 2)
    dispatch("movecursor", f"{x} {y}")
    print(f"Focused {name}")
    return 0


def move_workspace(name: str) -> int:
    name = validate_name(name)
    dispatch("movecurrentworkspacetomonitor", name)
    return focus(name)


def move_window(name: str) -> int:
    name = validate_name(name)
    dispatch("movewindow", f"mon:{name}")
    return focus(name)


def rule_for(monitor: dict) -> str:
    name = validate_name(monitor["name"])
    if monitor.get("disabled"):
        return f"{name},disable"
    refresh = float(monitor.get("refreshRate", 60))
    res = f"{monitor['width']}x{monitor['height']}@{refresh:.2f}"
    pos = f"{monitor.get('x', 0)}x{monitor.get('y', 0)}"
    scale = monitor.get("scale", 1)
    transform = monitor.get("transform", 0)
    rule = f"{name},{res},{pos},{scale},transform,{transform}"
    mirror = monitor.get("mirrorOf")
    if mirror and mirror != "none":
        rule += f",mirror,{validate_name(mirror)}"
    if not name.startswith(("eDP-", "LVDS-", "DSI-")):
        # Keep normal desktop content colour-correct. HDR remains opt-in because
        # forcing PQ for SDR applications produces a washed-out desktop.
        rule += ",cm,srgb"
    return rule


def apply_rule(rule: str) -> None:
    result = run(["hyprctl", "keyword", "monitor", rule])
    output = (result.stdout + result.stderr).lower()
    if any(word in output for word in ("invalid", "error", "failed")):
        raise RuntimeError(output.strip())


def save_snapshot(values: list[dict]) -> None:
    CONTROL_CONF.parent.mkdir(parents=True, exist_ok=True)
    monitor_file = CONTROL_CONF.parent / "monitors.conf"
    monitor_file.write_text("".join(f"monitor = {rule_for(m)}\n" for m in values), encoding="utf-8")
    ensure_source(monitor_file)


def save_rules(rules: list[str]) -> None:
    CONTROL_CONF.parent.mkdir(parents=True, exist_ok=True)
    safe_rules: list[str] = []
    for rule in rules:
        name = rule.split(",", 1)[0]
        if name.startswith(("eDP-", "LVDS-", "DSI-")) and rule.endswith(",disable"):
            # The event-driven policy disables the panel at runtime. Keeping a
            # usable internal rule on disk prevents a black login if no monitor
            # is attached before the watcher starts.
            safe_rules.append(f"{name},preferred,0x0,1")
        else:
            safe_rules.append(rule)
    MONITORS_CONF.write_text("".join(f"monitor = {rule}\n" for rule in safe_rules), encoding="utf-8")
    ensure_source(MONITORS_CONF)


def ensure_source(path: Path) -> None:
    if not HYPR_CONF.exists():
        return
    source = f"source = {path}"
    content = HYPR_CONF.read_text(encoding="utf-8")
    if source not in content:
        HYPR_CONF.write_text(content.rstrip() + f"\n\n{source}\n", encoding="utf-8")


def profile_rules(profile: str, values: list[dict]) -> list[str]:
    internal = internal_name(values)
    externals = external_names(values)
    if not internal:
        raise ValueError("No display is available")
    if profile != "laptop" and not externals:
        raise ValueError("Connect an external display first")

    rules: list[str] = []
    if profile == "extend":
        rules.append(f"{internal},preferred,0x0,1")
        for monitor in externals:
            rules.append(f"{monitor},preferred,auto-right,1,cm,srgb")
    elif profile == "mirror":
        rules.append(f"{internal},preferred,0x0,1")
        for monitor in externals:
            rules.append(f"{monitor},preferred,0x0,1,mirror,{internal}")
    elif profile == "laptop":
        rules.append(f"{internal},preferred,0x0,1")
        rules.extend(f"{monitor},disable" for monitor in externals)
    elif profile == "external":
        primary = externals[0]
        rules.append(f"{primary},preferred,0x0,1,cm,srgb")
        rules.extend(f"{monitor},preferred,auto-right,1,cm,srgb" for monitor in externals[1:])
        rules.append(f"{internal},disable")
    else:
        raise ValueError("Unknown display profile")
    return rules


def move_workspace_to(workspace: str | int, monitor: str) -> None:
    monitor = validate_name(monitor)
    dispatch("moveworkspacetomonitor", f"{workspace} {monitor}")


def centre_pointer(name: str) -> None:
    monitor = next((m for m in monitors() if m["name"] == name), None)
    if monitor is None:
        return
    dispatch("focusmonitor", name)
    x = int(monitor["x"] + monitor["width"] / max(float(monitor.get("scale", 1)), 0.25) / 2)
    y = int(monitor["y"] + monitor["height"] / max(float(monitor.get("scale", 1)), 0.25) / 2)
    dispatch("movecursor", f"{x} {y}")


def set_dpms(name: str, enabled: bool) -> None:
    """Power an output without destroying its compositor screen object."""
    name = validate_name(name)
    run(["hyprctl", "dispatch", "dpms", "on" if enabled else "off", name])


def ensure_headless_fallback(values: list[dict]) -> tuple[list[dict], str]:
    """Keep one invisible output alive for Qt during physical hotplug."""
    fallback = next((
        m for m in values
        if m["name"].startswith("HEADLESS-") and not m.get("disabled")
    ), None)
    if fallback is None:
        run(["hyprctl", "output", "create", "headless"], check=False)
        time.sleep(0.2)
        values = monitors()
        fallback = next((
            m for m in values
            if m["name"].startswith("HEADLESS-") and not m.get("disabled")
        ), None)
    if fallback is not None and (
        fallback.get("width") != 16
        or fallback.get("height") != 16
        or fallback.get("x") != 100000
        or fallback.get("y") != 100000
    ):
        # Do not leave the guard adjacent to a physical output. Otherwise the
        # cursor can cross onto its invisible workspace, breaking edge hovers
        # and sending keyboard focus away from the real monitor.
        apply_rule(f"{fallback['name']},16x16@60,100000x100000,1")
        time.sleep(0.1)
        values = monitors()
        fallback = next((
            m for m in values
            if m["name"].startswith("HEADLESS-") and not m.get("disabled")
        ), fallback)
    return values, fallback["name"] if fallback is not None else ""


def park_headless_workspace(fallback: str) -> None:
    if not fallback:
        return
    monitor = next((m for m in monitors() if m["name"] == fallback), None)
    active_name = monitor.get("activeWorkspace", {}).get("name", "") if monitor else ""
    if active_name == FALLBACK_WORKSPACE:
        return
    dispatch("focusmonitor", fallback)
    dispatch("workspace", f"name:{FALLBACK_WORKSPACE}")


def saved_monitor_rule(name: str) -> str:
    if not MONITORS_CONF.exists():
        return ""
    prefix = f"monitor = {name},"
    for line in MONITORS_CONF.read_text(encoding="utf-8").splitlines():
        if line.strip().startswith(prefix):
            rule = line.strip()[len("monitor = "):]
            if not rule.endswith(",disable"):
                return rule
    return ""


def apply_automatic() -> int:
    """Use exactly one screen: an external monitor when present, else the panel."""
    values = monitors()
    values, fallback = ensure_headless_fallback(values)
    internal = internal_name(values)
    externals = external_names(values)
    if not internal:
        raise ValueError("No laptop display was found")

    target = externals[0] if externals else internal
    target_rule = saved_monitor_rule(target)
    if not target_rule:
        target_rule = f"{target},preferred,0x0,1"
        if target != internal:
            target_rule += ",cm,srgb"

    # Bring up the chosen physical output before moving workspaces or disabling
    # the previous one. HEADLESS remains available only as a compositor guard.
    target_state = next((m for m in values if m["name"] == target), None)
    if target_state is None or target_state.get("disabled"):
        apply_rule(target_rule)
    set_dpms(target, True)

    park_headless_workspace(fallback)
    current_workspaces = workspaces()
    for workspace in current_workspaces:
        if (
            workspace.get("name") != FALLBACK_WORKSPACE
            and workspace.get("monitor") != target
        ):
            move_workspace_to(workspace.get("name", workspace.get("id")), target)
    centre_pointer(target)

    # DPMS-off is not enough: a lid event can wake eDP and make Qt create a
    # second shell. Keep exactly one physical output in the desktop instead.
    for output in [internal, *externals]:
        if output != target:
            apply_rule(f"{output},disable")

    run(["hyprctl", "keyword", "cursor:default_monitor", target], check=False)
    centre_pointer(target)
    print(json.dumps({
        "mode": "external-only" if externals else "laptop-only",
        "target": target,
    }))
    return 0


def event_socket_path() -> Path:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if signature:
        candidate = runtime / "hypr" / signature / ".socket2.sock"
        if candidate.exists():
            return candidate
    candidates = sorted(
        (runtime / "hypr").glob("*/.socket2.sock"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    if not candidates:
        raise FileNotFoundError("Hyprland event socket is unavailable")
    return candidates[0]


def watch() -> int:
    """Follow monitor hotplug/config events without polling."""
    while True:
        try:
            # Apply once at service startup, including sessions that began with
            # the external monitor already attached.
            for _ in range(20):
                try:
                    apply_automatic()
                    break
                except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
                    time.sleep(0.5)

            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
                client.connect(str(event_socket_path()))
                buffer = ""
                while True:
                    chunk = client.recv(8192)
                    if not chunk:
                        break
                    buffer += chunk.decode("utf-8", errors="replace")
                    lines = buffer.split("\n")
                    buffer = lines.pop()
                    display_events = [
                        line for line in lines if line.startswith((
                            "monitoradded", "monitorremoved", "configreloaded"
                        ))
                    ]
                    if display_events:
                        # Wake the retained laptop fallback almost immediately
                        # after a removal; additions need a little EDID settling.
                        delay = 0.12 if any(
                            line.startswith("monitorremoved")
                            for line in display_events
                        ) else 0.55
                        time.sleep(delay)
                        try:
                            apply_automatic()
                        except Exception as error:  # keep watcher alive
                            print(f"automatic display update failed: {error}", file=sys.stderr)
        except KeyboardInterrupt:
            return 0
        except Exception as error:
            print(f"display watcher reconnecting: {error}", file=sys.stderr)
            time.sleep(1)


def start_change(
    values: list[dict],
    apply_rules: list[str],
    persist_rules: list[str],
    label: str,
    *,
    target: str = "",
    migrate_from: list[str] | None = None,
) -> int:
    token = uuid.uuid4().hex[:12]
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state = STATE_DIR / f"display-revert-{token}.json"
    focused = next((m["name"] for m in values if m.get("focused")), "")
    assignments = [
        {"workspace": workspace.get("name", workspace.get("id")), "monitor": workspace.get("monitor", "")}
        for workspace in workspaces()
        if workspace.get("monitor")
    ]
    state.write_text(json.dumps({
        "created": time.time(),
        "monitors": values,
        "rules": persist_rules,
        "focused": focused,
        "defaultMonitor": option("cursor:default_monitor") or "",
        "workspaces": assignments,
        "target": target,
    }), encoding="utf-8")
    try:
        if target:
            # Move live workspaces while both outputs still exist. If Hyprland
            # disables their monitor first it can select an arbitrary remaining
            # workspace, leaving keyboard focus feeling lost.
            sources = set(migrate_from or [])
            for assignment in assignments:
                if assignment["monitor"] in sources:
                    move_workspace_to(assignment["workspace"], target)
            centre_pointer(target)
        for rule in apply_rules:
            apply_rule(rule)
        if target:
            centre_pointer(target)
            run(["hyprctl", "keyword", "cursor:default_monitor", target])
    except Exception:
        rollback(token)
        raise
    executable = str(Path(__file__).resolve())
    subprocess.run([
        "systemd-run", "--user", "--quiet", f"--unit=caelestia-display-revert-{token}",
        "--on-active=20s", executable, "rollback", token
    ], check=True, timeout=10)
    print(json.dumps({"token": token, "profile": label, "timeout": 20}))
    return 0


def apply_profile(profile: str) -> int:
    values = monitors()
    rules = profile_rules(profile, values)
    internal = internal_name(values)
    externals = external_names(values)
    if profile == "external":
        return start_change(
            values, rules, rules, profile,
            target=externals[0], migrate_from=[internal],
        )
    if profile == "laptop":
        return start_change(
            values, rules, rules, profile,
            target=internal, migrate_from=externals,
        )
    return start_change(values, rules, rules, profile)


def apply_custom(name: str, resolution: str, position: str, scale_text: str, transform_text: str) -> int:
    name = validate_name(name)
    values = monitors()
    selected = next((monitor for monitor in values if monitor["name"] == name), None)
    if selected is None:
        raise ValueError("Display is not currently active")
    if resolution == "disable":
        if len(values) < 2:
            raise ValueError("Another active display is required before disabling this one")
        rule = f"{name},disable"
    else:
        if resolution != "preferred" and not VALID_RESOLUTION.fullmatch(resolution):
            raise ValueError("Invalid display resolution")
        if not VALID_POSITION.fullmatch(position):
            raise ValueError("Invalid display position")
        try:
            scale = float(scale_text)
            transform = int(transform_text)
        except ValueError as error:
            raise ValueError("Invalid display scale or orientation") from error
        if not 0.5 <= scale <= 4:
            raise ValueError("Display scale must be between 50% and 400%")
        if transform not in range(8):
            raise ValueError("Invalid display orientation")
        rule = f"{name},{resolution},{position},{scale:g},transform,{transform}"
        if not name.startswith(("eDP-", "LVDS-", "DSI-")):
            rule += ",cm,srgb"

    persist_rules = [rule if monitor["name"] == name else rule_for(monitor) for monitor in values]
    return start_change(values, [rule], persist_rules, "custom")


def rollback(token: str) -> int:
    if not re.fullmatch(r"[0-9a-f]{12}", token):
        raise ValueError("Invalid rollback token")
    state = STATE_DIR / f"display-revert-{token}.json"
    if not state.exists():
        return 0
    payload = json.loads(state.read_text(encoding="utf-8"))
    for monitor in payload.get("monitors", []):
        apply_rule(rule_for(monitor))
    for assignment in payload.get("workspaces", []):
        if assignment.get("monitor"):
            move_workspace_to(assignment.get("workspace"), assignment["monitor"])
    previous_default = payload.get("defaultMonitor", "")
    run([
        "hyprctl", "keyword", "cursor:default_monitor",
        previous_default if previous_default and previous_default != "[[EMPTY]]" else "[[EMPTY]]"
    ], check=False)
    if payload.get("focused"):
        centre_pointer(payload["focused"])
    state.unlink(missing_ok=True)
    return 0


def confirm(token: str) -> int:
    if not re.fullmatch(r"[0-9a-f]{12}", token):
        raise ValueError("Invalid confirmation token")
    subprocess.run([
        "systemctl", "--user", "stop", f"caelestia-display-revert-{token}.timer",
        f"caelestia-display-revert-{token}.service"
    ], capture_output=True, timeout=10)
    state = STATE_DIR / f"display-revert-{token}.json"
    if not state.exists():
        raise ValueError("Display confirmation expired")
    payload = json.loads(state.read_text(encoding="utf-8"))
    save_rules(payload.get("rules", []))
    if payload.get("target"):
        pointer = bool(option("misc:mouse_move_focuses_monitor"))
        warp = int(option("cursor:warp_on_change_workspace") or 0) > 0
        write_policies(pointer, warp, payload["target"])
    state.unlink()
    print("Display layout saved")
    return 0


def write_policies(pointer_follows: bool, warp: bool, default_monitor: str) -> None:
    if default_monitor and default_monitor != "[[EMPTY]]":
        validate_name(default_monitor)
    CONTROL_CONF.parent.mkdir(parents=True, exist_ok=True)
    CONTROL_CONF.write_text(
        "misc {\n"
        f"    mouse_move_focuses_monitor = {'true' if pointer_follows else 'false'}\n"
        "}\n\n"
        "cursor {\n"
        f"    warp_on_change_workspace = {1 if warp else 0}\n"
        f"    default_monitor = {default_monitor if default_monitor else '[[EMPTY]]'}\n"
        "}\n",
        encoding="utf-8",
    )
    ensure_source(CONTROL_CONF)
    run(["hyprctl", "keyword", "misc:mouse_move_focuses_monitor", "1" if pointer_follows else "0"])
    run(["hyprctl", "keyword", "cursor:warp_on_change_workspace", "1" if warp else "0"])
    run(["hyprctl", "keyword", "cursor:default_monitor", default_monitor or "[[EMPTY]]"])


def set_policy(name: str, value: str) -> int:
    pointer = bool(option("misc:mouse_move_focuses_monitor"))
    warp = int(option("cursor:warp_on_change_workspace") or 0) > 0
    default = str(option("cursor:default_monitor") or "")
    if default == "[[EMPTY]]":
        default = ""
    enabled = value == "on"
    if name == "pointer":
        pointer = enabled
    elif name == "warp":
        warp = enabled
    else:
        raise ValueError("Unknown focus policy")
    write_policies(pointer, warp, default)
    return 0


def set_primary(name: str) -> int:
    name = validate_name(name)
    pointer = bool(option("misc:mouse_move_focuses_monitor"))
    warp = int(option("cursor:warp_on_change_workspace") or 0) > 0
    write_policies(pointer, warp, name)
    print(f"{name} will receive focus at startup")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    sub.add_parser("auto")
    sub.add_parser("watch")
    for command in ("focus", "move-workspace", "move-window", "primary"):
        item = sub.add_parser(command)
        item.add_argument("monitor")
    mode = sub.add_parser("mode")
    mode.add_argument("profile", choices=("extend", "mirror", "laptop", "external"))
    apply = sub.add_parser("apply")
    apply.add_argument("--name", required=True)
    apply.add_argument("--resolution", required=True)
    apply.add_argument("--position", default="0x0")
    apply.add_argument("--scale", default="1")
    apply.add_argument("--transform", default="0")
    for command in ("confirm", "rollback"):
        item = sub.add_parser(command)
        item.add_argument("token")
    policy = sub.add_parser("policy")
    policy.add_argument("name", choices=("pointer", "warp"))
    policy.add_argument("value", choices=("on", "off"))
    args = parser.parse_args()

    try:
        if args.command == "status":
            return status()
        if args.command == "auto":
            return apply_automatic()
        if args.command == "watch":
            return watch()
        if args.command == "focus":
            return focus(args.monitor)
        if args.command == "move-workspace":
            return move_workspace(args.monitor)
        if args.command == "move-window":
            return move_window(args.monitor)
        if args.command == "primary":
            return set_primary(args.monitor)
        if args.command == "mode":
            return apply_profile(args.profile)
        if args.command == "apply":
            return apply_custom(args.name, args.resolution, args.position, args.scale, args.transform)
        if args.command == "confirm":
            return confirm(args.token)
        if args.command == "rollback":
            return rollback(args.token)
        if args.command == "policy":
            return set_policy(args.name, args.value)
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
