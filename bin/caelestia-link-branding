#!/bin/sh
set -eu

# KDE Connect is retained as the protocol engine; every user-facing desktop
# surface is branded as Caelestia Link after package upgrades.
user_apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
mkdir -p "$user_apps"

for desktop in \
    /usr/share/applications/org.kde.kdeconnect.app.desktop \
    /usr/share/applications/org.kde.kdeconnect.daemon.desktop \
    /usr/share/applications/org.kde.kdeconnect.handler.desktop \
    /usr/share/applications/org.kde.kdeconnect.nonplasma.desktop \
    /usr/share/applications/org.kde.kdeconnect.sms.desktop; do
    if [ -f "$desktop" ]; then
        filename=$(basename "$desktop")
        target="$user_apps/$filename"
        cp "$desktop" "$target"
        if [ "$filename" = "org.kde.kdeconnect.sms.desktop" ]; then
            sed -i '0,/^Name=.*/s//Name=Caelestia Link Messages/' "$target"
        else
            sed -i '0,/^Name=.*/s//Name=Caelestia Link/' "$target"
        fi
    fi
done

command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$user_apps" || true
