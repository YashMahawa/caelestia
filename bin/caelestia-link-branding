#!/bin/sh
set -eu

# KDE Connect is retained as the protocol engine; every user-facing desktop
# surface is branded as Caelestia Link after package upgrades.
if [ "$(id -u)" -eq 0 ] || [ -w /usr/share/applications ]; then
    for desktop in \
        /usr/share/applications/org.kde.kdeconnect.app.desktop \
        /usr/share/applications/org.kde.kdeconnect.daemon.desktop \
        /usr/share/applications/org.kde.kdeconnect.handler.desktop; do
        [ ! -f "$desktop" ] || sed -i '0,/^Name=.*/s//Name=Caelestia Link/' "$desktop" 2>/dev/null || true
    done

    desktop=/usr/share/applications/org.kde.kdeconnect.nonplasma.desktop
    [ ! -f "$desktop" ] || sed -i '0,/^Name=.*/s//Name=Caelestia Link/' "$desktop" 2>/dev/null || true

    desktop=/usr/share/applications/org.kde.kdeconnect.sms.desktop
    [ ! -f "$desktop" ] || sed -i '0,/^Name=.*/s//Name=Caelestia Link Messages/' "$desktop" 2>/dev/null || true

    extension=/usr/share/nautilus-python/extensions/kdeconnect-share.py
    if [ -f "$extension" ]; then
        sed -i \
            -e 's/Share files to your phone via KDE Connect/Share files with Caelestia Link/' \
            -e 's/Send to %s via KDE Connect/Send to %s via Caelestia Link/' \
            -e 's/Send via KDE Connect/Send via Caelestia Link/' \
            "$extension" 2>/dev/null || true
    fi

    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database /usr/share/applications || true
fi

# Also update user-space application desktop files
user_apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
mkdir -p "$user_apps" 2>/dev/null || true

for desktop in \
    /usr/share/applications/org.kde.kdeconnect.app.desktop \
    /usr/share/applications/org.kde.kdeconnect.daemon.desktop \
    /usr/share/applications/org.kde.kdeconnect.handler.desktop \
    /usr/share/applications/org.kde.kdeconnect.nonplasma.desktop \
    /usr/share/applications/org.kde.kdeconnect.sms.desktop; do
    if [ -f "$desktop" ]; then
        filename=$(basename "$desktop")
        target="$user_apps/$filename"
        cp "$desktop" "$target" 2>/dev/null || true
        if [ "$filename" = "org.kde.kdeconnect.sms.desktop" ]; then
            sed -i '0,/^Name=.*/s//Name=Caelestia Link Messages/' "$target" 2>/dev/null || true
        else
            sed -i '0,/^Name=.*/s//Name=Caelestia Link/' "$target" 2>/dev/null || true
        fi
    fi
done

command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$user_apps" || true
