#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia"
STATE_FILE="$STATE_DIR/session-lock"

case "${1:-}" in
    locked)
        signature="${HYPRLAND_INSTANCE_SIGNATURE:-}"
        if [ -z "$signature" ]; then
            signature="$(
                find "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" \
                    -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null |
                    head -n 1
            )"
        fi
        [ -n "$signature" ] || exit 0
        mkdir -p "$STATE_DIR"
        tmp="${STATE_FILE}.tmp.$$"
        printf '%s\n' "$signature" > "$tmp"
        mv -f "$tmp" "$STATE_FILE"
        ;;
    unlocked)
        rm -f "$STATE_FILE"
        ;;
    *)
        printf 'usage: caelestia-lock-state locked|unlocked\n' >&2
        exit 2
        ;;
esac
