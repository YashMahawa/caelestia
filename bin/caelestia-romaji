#!/usr/bin/env bash
# Romanises timed lyrics for Caelestia (Japanese, Chinese, Korean).
# Runs the Python implementation inside its dedicated virtual environment,
# creating it on first use.
set -euo pipefail

venv="${XDG_DATA_HOME:-$HOME/.local/share}/caelestia/romaji-venv"
if [[ ! -x $venv/bin/python ]]; then
    command -v uv >/dev/null || { echo '{"error":"uv is required to set up romanisation"}'; exit 1; }
    uv venv -q "$venv" >&2
    VIRTUAL_ENV=$venv uv pip install -q cutlet fugashi unidic-lite pypinyin >&2
fi
exec "$venv/bin/python" "$(dirname "$(readlink -f "$0")")/caelestia-romaji.py" "$@"
