#!/usr/bin/env bash
set -euo pipefail

# Locking belongs to caelestia-pre-sleep-lock.service so lid-close, idle and
# manual requests all follow the same fail-closed path without racing QML.
if ! systemctl is-enabled --quiet caelestia-pre-sleep-lock.service; then
    notify-send -u critical "Suspend cancelled" "The Caelestia pre-sleep lock service is not installed."
    exit 1
fi
exec systemctl suspend
