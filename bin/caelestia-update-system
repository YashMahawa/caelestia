#!/usr/bin/env bash
# Safe, customisation-preserving system update for this Caelestia setup.
#
#   caelestia-update-system            interactive full update
#   caelestia-update-system --check    only report what would be updated
#   caelestia-update-system --no-ai    skip AI tooling updates
#
# Steps: preflight (power/thermal) -> snapshot of customised files -> verify
# the shell fork holds every live QML change -> pacman/AUR update honouring
# IgnorePkg holds -> AI CLI self-updates -> post-update health checks.
# Kernels stay held; upgrade them deliberately (see `kernel_notes` below).
set -euo pipefail

check_only=0
with_ai=1
for arg in "$@"; do
    case $arg in
        --check) check_only=1 ;;
        --no-ai) with_ai=0 ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "Unknown option: $arg" >&2; exit 2 ;;
    esac
done

bold=$'\e[1m'; dim=$'\e[2m'; red=$'\e[31m'; green=$'\e[32m'; yellow=$'\e[33m'; reset=$'\e[0m'
step() { printf '\n%s==> %s%s\n' "$bold" "$*" "$reset"; }
ok() { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$*"; }
fail() { printf '  %s✗%s %s\n' "$red" "$reset" "$*"; }

helper=$(command -v paru || command -v yay || true)
[[ -n $helper ]] || { fail "Neither paru nor yay is installed"; exit 1; }

# ---- preflight -------------------------------------------------------------
step "Preflight"
on_ac=0
for supply in /sys/class/power_supply/*; do
    [[ -r $supply/type && $(<"$supply/type") == Mains && -r $supply/online ]] && [[ $(<"$supply/online") == 1 ]] && on_ac=1
done
battery=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1 || echo 100)
if (( on_ac )); then ok "On AC power"; elif (( battery >= 40 )); then warn "On battery (${battery}%)"; else
    fail "Battery at ${battery}% — plug in before updating"; exit 1; fi

temp=0
for zone in /sys/class/thermal/thermal_zone*; do
    [[ $(<"$zone/type") == x86_pkg_temp ]] && temp=$(( $(<"$zone/temp") / 1000 ))
done
if (( temp >= 80 )); then
    fail "CPU package at ${temp}°C — let it cool first (thermal cutoff risk on this chassis)"; exit 1
fi
ok "CPU package ${temp}°C"
ok "Holds: $(grep -E '^IgnorePkg' /etc/pacman.conf | cut -d= -f2 | xargs)"

if (( check_only )); then
    step "Pending updates"
    checkupdates 2>/dev/null || true
    "$helper" -Qua 2>/dev/null || true
    exit 0
fi

# ---- snapshot --------------------------------------------------------------
step "Snapshot of customised files"
stamp=$(date +%Y%m%d-%H%M%S)
snapshot="$HOME/.local/share/caelestia-backups/update-$stamp"
mkdir -p "$snapshot"
copy() { [[ -e $1 ]] && mkdir -p "$snapshot/$(dirname "${1#/}")" && cp -a "$1" "$snapshot/${1#/}"; }
for path in \
    "$HOME/.config/hypr/hyprland.lua" "$HOME/.config/hypr/hyprland" "$HOME/.config/hypr/monitors.conf" \
    "$HOME/.config/caelestia" "$HOME/.config/mpv/mpv.conf" "$HOME/.config/systemd/user" \
    /etc/pacman.conf /etc/modprobe.d/mt7921e.conf /etc/sddm.conf.d; do
    copy "$path" || true
done
rsync -a --exclude build --exclude build-plugin --exclude .cache \
    "$HOME/.config/quickshell/caelestia/" "$snapshot/quickshell-caelestia/"
ok "Saved to $snapshot ($(du -sh "$snapshot" | cut -f1))"

# The package hook rebuilds the live shell from the fork, so any live-only
# change would be lost. Refuse to continue until the fork holds everything.
fork="$HOME/caelestia-repo-work/shell"
if [[ -d $fork/.git ]]; then
    drift=""
    # Exactly the entries the package hook copies from the fork.
    for entry in assets components modules services utils shell.qml greeter.qml; do
        [[ -e $HOME/.config/quickshell/caelestia/$entry ]] || continue
        drift+=$(diff -rq "$HOME/.config/quickshell/caelestia/$entry" "$fork/$entry" -x '*.pyc' -x __pycache__ 2>/dev/null \
            | grep -E "^Only in $HOME/.config|differ$" || true)
    done
    if [[ -n $drift ]]; then
        fail "Live shell has changes the fork does not contain:"
        printf '%s\n' "$drift" | sed 's/^/      /'
        fail "Commit them to $fork first (the snapshot above keeps a copy)."
        exit 1
    fi
    ok "Shell fork matches the live config"
fi

# ---- packages --------------------------------------------------------------
step "System packages ($(basename "$helper"), holds respected)"
"$helper" -Syu

# ---- AI tooling ------------------------------------------------------------
if (( with_ai )); then
    step "AI tooling"
    command -v claude >/dev/null && { claude update && ok "Claude Code $(claude --version | cut -d' ' -f1)" || warn "Claude Code update failed"; }
    command -v codex >/dev/null && { codex update && ok "$(codex --version)" || warn "Codex update failed"; }
    if command -v npm >/dev/null && npm ls -g --depth=0 2>/dev/null | grep -q '@google/gemini-cli'; then
        npm install -g @google/gemini-cli@latest >/dev/null && ok "Gemini CLI updated" || warn "Gemini CLI update failed"
    fi
    for app in antigravity chatgpt-official; do
        latest=$(ls -d "$HOME/.local/opt/$app-"* 2>/dev/null | sort -V | tail -1)
        [[ -n $latest ]] && printf '  %s·%s %s %s (manual updates: stage side by side, test, then switch)%s\n' "$dim" "$reset" "$app" "${latest##*-}" "$reset"
    done
fi

# ---- health checks ---------------------------------------------------------
step "Post-update checks"
for kernel in /usr/lib/modules/*/; do
    version=$(basename "$kernel")
    [[ -e $kernel/vmlinuz ]] || continue
    if find "$kernel" -path '*updates*' -name 'mt7921e.ko*' | grep -q .; then
        ok "MT7902 driver built for $version"
    else
        fail "MT7902 driver missing for $version — run: sudo dkms autoinstall -k $version"
    fi
done
/usr/bin/quickshell --private-check-compat >/dev/null 2>&1 && ok "Quickshell compatible with installed Qt" \
    || warn "Quickshell reports a Qt compatibility problem — rebuild quickshell-git before restarting the shell"
systemctl --user is-active --quiet caelestia-quickshell.service && ok "Shell running" || warn "Shell is not running"
ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && ok "Network reachable" || warn "Network check failed"
"$HOME/.local/bin/caelestia-media-cache" gc >/dev/null 2>&1 || true

cat <<EOF

${dim}Kernels are held on purpose. To move to a new kernel: install it and its
headers explicitly, confirm the MT7902 DKMS module builds for it, regenerate
the initramfs, and add it to Grub2Win's grub.cfg while keeping the current
kernels as fallbacks.${reset}
EOF
ok "Done. Snapshot: $snapshot"
