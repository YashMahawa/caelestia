#!/usr/bin/env python3
"""Native Quickshell voice dictation controller bridge for Caelestia."""

from __future__ import annotations

import subprocess
import sys


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if command not in ("toggle", "start", "stop", "status"):
        raise SystemExit("usage: caelestia-voice [toggle|start|stop|status]")

    res = subprocess.run(
        ["caelestia", "shell", "voice", command],
        capture_output=True,
        text=True,
        check=False,
    )
    if res.stdout:
        print(res.stdout.strip())


if __name__ == "__main__":
    main()
