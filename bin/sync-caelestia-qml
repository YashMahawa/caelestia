#!/usr/bin/env bash
set -euo pipefail

restart_shell=0
target_user=""

for arg in "$@"; do
    case "$arg" in
        --restart)
            restart_shell=1
            ;;
        -*)
            ;;
        *)
            if [[ -z "$target_user" ]]; then
                target_user="$arg"
            fi
            ;;
    esac
done

# Target user resolution: never infer root from USER/HOME when invoked by a package hook
user_name=""
if [[ -n "$target_user" ]]; then
    if [[ "$target_user" == "root" || "$(id -u "$target_user" 2>/dev/null || echo 0)" -eq 0 ]]; then
        echo "sync-caelestia-qml: Refusing to sync QML for root user; skipping." >&2
        exit 0
    fi
    user_name="$target_user"
elif [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
    user_name="$SUDO_USER"
elif [[ -n "${USER:-}" && "$USER" != "root" && "$(id -u "${USER}" 2>/dev/null || id -u)" -ne 0 ]]; then
    user_name="$USER"
elif [[ -n "${LOGNAME:-}" && "$LOGNAME" != "root" ]]; then
    user_name="$LOGNAME"
else
    if command -v loginctl >/dev/null 2>&1; then
        user_name="$(loginctl list-sessions 2>/dev/null | awk '$3 != "root" && $3 ~ /^[a-zA-Z0-9_-]+$/ {print $3; exit}')"
    fi
    if [[ -z "$user_name" ]]; then
        user_name="$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "nobody" {print $1; exit}')"
    fi
fi

if [[ -z "$user_name" || "$user_name" == "root" ]]; then
    echo "sync-caelestia-qml: Cannot determine a valid non-root user; skipping QML sync." >&2
    exit 0
fi

user_id="$(id -u "$user_name" 2>/dev/null || true)"
if [[ -z "$user_id" || "$user_id" -eq 0 ]]; then
    echo "sync-caelestia-qml: Refusing to sync QML for root user ($user_name); skipping." >&2
    exit 0
fi

user_home="$(getent passwd "$user_name" 2>/dev/null | cut -d: -f6)"
if [[ -z "$user_home" || "$user_home" == "/root" ]]; then
    echo "sync-caelestia-qml: Invalid home directory ($user_home) for user $user_name; skipping." >&2
    exit 0
fi

# Helper to run commands as target user when running as root
run_as_target() {
    local cmd="$1"
    if [[ "$(id -u)" -eq 0 ]]; then
        if command -v sudo >/dev/null 2>&1; then
            sudo -u "$user_name" env HOME="$user_home" PATH="$PATH" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$user_id}" bash -c "$cmd"
        elif command -v setpriv >/dev/null 2>&1; then
            setpriv --reuid="$user_id" --regid="$(id -g "$user_name")" --clear-groups env HOME="$user_home" PATH="$PATH" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$user_id}" bash -c "$cmd"
        else
            su -s /bin/bash "$user_name" -c "$cmd"
        fi
    else
        bash -c "$cmd"
    fi
}

# Resolve package source from colon-separated XDG_CONFIG_DIRS search list
package_src=""
config_dirs="${XDG_CONFIG_DIRS:-/etc/xdg}"
IFS=':' read -ra dirs <<< "$config_dirs"
for dir in "${dirs[@]}"; do
    [[ -z "$dir" ]] && continue
    candidate="$dir/quickshell/caelestia"
    if [[ -d "$candidate" ]]; then
        package_src="$candidate"
        break
    fi
done

fork_src="$user_home/caelestia-repo-work/shell"
dst="$user_home/.config/quickshell/caelestia"
parent="$(dirname "$dst")"

# Ensure parent config directory and dst exist with target user ownership
run_as_target "mkdir -p '$parent' '$dst'"

# Transactional plugin compilation and installation
if [[ -f "$fork_src/CMakeLists.txt" ]]; then
    build_dir="$user_home/.cache/caelestia-shell-plugin-build"
    run_as_target "mkdir -p '$build_dir' '$user_home/.local'"
    run_as_target "cmake -S '$fork_src' -B '$build_dir' -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX='$user_home/.local' -DENABLE_MODULES=plugin"
    run_as_target "cmake --build '$build_dir' -j4"
    run_as_target "cmake --install '$build_dir' --prefix '$user_home/.local'"
fi

# Stage runtime QML entries
stage="$(run_as_target "mktemp -d '$parent/.caelestia-sync.XXXXXX'")"

cleanup() {
    rm -rf "$stage" 2>/dev/null || true
}
trap cleanup EXIT

run_as_target "mkdir -p '$stage/caelestia'"

# 1. Copy package source runtime QML if present
if [[ -n "$package_src" && -d "$package_src" ]]; then
    for entry in assets components modules services utils shell.qml greeter.qml; do
        if [[ -e "$package_src/$entry" ]]; then
            run_as_target "cp -a '$package_src/$entry' '$stage/caelestia/'"
        fi
    done
fi

# 2. Overlay customized fork runtime QML entries if present
if [[ -d "$fork_src" ]]; then
    for entry in assets components modules services utils shell.qml greeter.qml; do
        if [[ -e "$fork_src/$entry" ]]; then
            run_as_target "cp -a '$fork_src/$entry' '$stage/caelestia/'"
        fi
    done
fi

# 3. Remove obsolete surfaces from stage
run_as_target "rm -f \
    '$stage/caelestia/modules/continuity/CallGuard.qml' \
    '$stage/caelestia/modules/continuity/ContinuityIsland.qml' \
    '$stage/caelestia/modules/dashboard/AgentsTab.qml'"

# 4. Perform scoped updates into live $dst WITHOUT replacing the whole tree
# This keeps all non-QML user files (user.json, user.conf, hypr-user.conf, lua/, etc.) completely untouched.
for entry in assets components modules services utils shell.qml greeter.qml; do
    if [[ -e "$stage/caelestia/$entry" ]]; then
        if [[ -d "$stage/caelestia/$entry" ]]; then
            run_as_target "mkdir -p '$dst/$entry' && cp -a '$stage/caelestia/$entry/.' '$dst/$entry/'"
        else
            run_as_target "cp -a '$stage/caelestia/$entry' '$dst/$entry'"
        fi
    fi
done

# 5. Clean up obsolete surfaces from live $dst if present
run_as_target "rm -f \
    '$dst/modules/continuity/CallGuard.qml' \
    '$dst/modules/continuity/ContinuityIsland.qml' \
    '$dst/modules/dashboard/AgentsTab.qml'"

if [[ "$restart_shell" -eq 1 ]]; then
    run_as_target "systemctl --user restart caelestia-quickshell.service >/dev/null 2>&1 || true"
    echo "Synced and restarted the customized Caelestia shell for $user_name"
else
    echo "Synced the customized Caelestia shell for $user_name (restart deferred; run 'caelestia shell -r' or 'systemctl --user restart caelestia-quickshell.service' to apply)"
fi
