+set -euo pipefail
+cd -- "$(dirname -- "$0")"
+mkdir -p build
+wayland-scanner client-header ../../../protocols/virtual-keyboard-unstable-v1.xml build/virtual-keyboard-client.h
+wayland-scanner private-code ../../../protocols/virtual-keyboard-unstable-v1.xml build/virtual-keyboard-protocol.c
+wayland-scanner client-header ../../../protocols/wlr-virtual-pointer-unstable-v1.xml build/virtual-pointer-client.h
+wayland-scanner private-code ../../../protocols/wlr-virtual-pointer-unstable-v1.xml build/virtual-pointer-protocol.c
+cc -O2 -Wall -Wextra -Werror -Ibuild inject.c build/*-protocol.c $(pkg-config --cflags --libs wayland-client xkbcommon) -o build/inject
diff --git a/tests/multiseat/input-client/inject.c b/tests/multiseat/input-client/inject.c
new file mode 100644
index 0000000..36f58c4
--- /dev/null
+++ b/tests/multiseat/input-client/inject.c
@@ -0,0 +1,112 @@
+#define _GNU_SOURCE
+/* Synthetic Wayland input for private nms-* test runtimes only. No evdev/uinput. */
+#include <wayland-client.h>
+#include <xkbcommon/xkbcommon.h>
+#include <sys/mman.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <time.h>
+#include <limits.h>
+#include "virtual-keyboard-client.h"
+#include "virtual-pointer-client.h"
+
+struct test_seat { struct wl_seat *seat; char name[128]; };
+static struct test_seat seats[16];
+static unsigned seat_count;
+static struct zwp_virtual_keyboard_manager_v1 *keyboards;
+static struct zwlr_virtual_pointer_manager_v1 *pointers;
+static void caps(void *data, struct wl_seat *seat, uint32_t cap) { (void)data; (void)seat; (void)cap; }
+static void name(void *data, struct wl_seat *seat, const char *value) {
+    (void)seat;
+    snprintf(((struct test_seat *)data)->name, 128, "%s", value);
+}
+static const struct wl_seat_listener seat_listener = {caps, name};
+static void global(void *data, struct wl_registry *registry, uint32_t id, const char *interface, uint32_t version) {
+    (void)data;
+    if (!strcmp(interface, "wl_seat") && seat_count < 16) {
+        struct test_seat *seat = &seats[seat_count++];
+        seat->seat = wl_registry_bind(registry, id, &wl_seat_interface, version < 9 ? version : 9);
+        wl_seat_add_listener(seat->seat, &seat_listener, seat);
+    } else if (!strcmp(interface, "zwp_virtual_keyboard_manager_v1"))
+        keyboards = wl_registry_bind(registry, id, &zwp_virtual_keyboard_manager_v1_interface, 1);
+    else if (!strcmp(interface, "zwlr_virtual_pointer_manager_v1"))
+        pointers = wl_registry_bind(registry, id, &zwlr_virtual_pointer_manager_v1_interface, version < 2 ? version : 2);
+}
+static void removed(void *data, struct wl_registry *registry, uint32_t id) { (void)data; (void)registry; (void)id; }
+static const struct wl_registry_listener registry_listener = {global, removed};
+static uint32_t now(void) {
+    struct timespec time;
+    clock_gettime(CLOCK_MONOTONIC, &time);
+    return (uint32_t)((uint64_t)time.tv_sec * 1000 + time.tv_nsec / 1000000);
+}
+
+int main(int argc, char **argv) {
+    char resolved[PATH_MAX];
+    if (argc != 3 || !realpath(argv[1], resolved) || strncmp(resolved, "/tmp/nms-", 9)) {
+        fprintf(stderr, "Refusing input outside a private /tmp/nms-* runtime\n");
+        return 2;
+    }
+    struct wl_display *display = wl_display_connect(resolved);
+    if (!display) return 3;
+    struct wl_registry *registry = wl_display_get_registry(display);
+    wl_registry_add_listener(registry, &registry_listener, NULL);
+    if (wl_display_roundtrip(display) < 0 || wl_display_roundtrip(display) < 0) return 4;
+    struct wl_seat *selected = NULL;
+    for (unsigned i = 0; i < seat_count; ++i)
+        if (!strcmp(seats[i].name, argv[2])) selected = seats[i].seat;
+    if (!selected || !keyboards || !pointers) return 5;
+    struct zwp_virtual_keyboard_v1 *keyboard = zwp_virtual_keyboard_manager_v1_create_virtual_keyboard(keyboards, selected);
+    struct zwlr_virtual_pointer_v1 *pointer = zwlr_virtual_pointer_manager_v1_create_virtual_pointer(pointers, selected);
+    struct xkb_context *context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+    const struct xkb_rule_names rules = {.rules="evdev", .model="pc105", .layout="us"};
+    struct xkb_keymap *keymap = xkb_keymap_new_from_names(context, &rules, XKB_KEYMAP_COMPILE_NO_FLAGS);
+    if (!keymap) return 6;
+    struct xkb_state *state = xkb_state_new(keymap);
+    char *text = xkb_keymap_get_as_string(keymap, XKB_KEYMAP_FORMAT_TEXT_V1);
+    size_t size = strlen(text) + 1;
+    int fd = memfd_create("native-seat-test-keymap", MFD_CLOEXEC);
+    if (fd < 0 || ftruncate(fd, size) || pwrite(fd, text, size, 0) != (ssize_t)size) return 7;
+    zwp_virtual_keyboard_v1_keymap(keyboard, WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1, fd, size);
+    close(fd); free(text);
+    if (wl_display_roundtrip(display) < 0) return 8;
+    puts("ready"); fflush(stdout);
+    char line[256], command[32];
+    while (fgets(line, sizeof(line), stdin)) {
+        unsigned code, pressed, x, y, width, height;
+        double dx, dy;
+        command[0] = 0;
+        sscanf(line, "%31s", command);
+        if (!strcmp(command, "quit")) break;
+        if (sscanf(line, "key %u %u", &code, &pressed) == 2) {
+            zwp_virtual_keyboard_v1_key(keyboard, now(), code, pressed);
+            xkb_state_update_key(state, code + 8, pressed ? XKB_KEY_DOWN : XKB_KEY_UP);
+            zwp_virtual_keyboard_v1_modifiers(keyboard,
+                xkb_state_serialize_mods(state, XKB_STATE_MODS_DEPRESSED),
+                xkb_state_serialize_mods(state, XKB_STATE_MODS_LATCHED),
+                xkb_state_serialize_mods(state, XKB_STATE_MODS_LOCKED),
+                xkb_state_serialize_layout(state, XKB_STATE_LAYOUT_EFFECTIVE));
+        } else if (sscanf(line, "move %lf %lf", &dx, &dy) == 2) {
+            zwlr_virtual_pointer_v1_motion(pointer, now(), wl_fixed_from_double(dx), wl_fixed_from_double(dy));
+            zwlr_virtual_pointer_v1_frame(pointer);
+        } else if (sscanf(line, "abs %u %u %u %u", &x, &y, &width, &height) == 4) {
+            zwlr_virtual_pointer_v1_motion_absolute(pointer, now(), x, y, width, height);
+            zwlr_virtual_pointer_v1_frame(pointer);
+        } else if (sscanf(line, "button %u %u", &code, &pressed) == 2) {
+            zwlr_virtual_pointer_v1_button(pointer, now(), code, pressed);
+            zwlr_virtual_pointer_v1_frame(pointer);
+        } else if (strcmp(command, "sync")) {
+            fprintf(stderr, "Unknown test input command\n"); return 9;
+        }
+        if (wl_display_roundtrip(display) < 0) return 10;
+        puts("ok"); fflush(stdout);
+    }
+    zwlr_virtual_pointer_v1_destroy(pointer);
+    zwp_virtual_keyboard_v1_destroy(keyboard);
+    wl_display_roundtrip(display);
+    xkb_state_unref(state); xkb_keymap_unref(keymap); xkb_context_unref(context);
+    wl_display_disconnect(display);
+    return 0;
+}
diff --git a/tests/multiseat/native_runtime.py b/tests/multiseat/native_runtime.py
new file mode 100644
index 0000000..41aa9a0
--- /dev/null
+++ b/tests/multiseat/native_runtime.py
@@ -0,0 +1,129 @@
+"""Private development-compositor harness. All injected input uses its socket."""
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import tempfile
+import time
+
+BINARY = Path(os.environ.get('NATIVE_TEST_BINARY', str(Path(__file__).resolve().parents[2]/'build-native/Hyprland')))
+
+class NativeRuntime:
+    def __init__(self):
+        self.parent = dict(os.environ)
+        self.root = Path(tempfile.mkdtemp(prefix='nms-'))
+        self.root.chmod(0o700)
+        self.children = []
+        self.process = None
+        self.pid = None
+        self.rule = '_G.caelestia_native_test_rule'
+        parent_socket = Path(self.parent['WAYLAND_DISPLAY'])
+        if not parent_socket.is_absolute():
+            parent_socket = Path(self.parent['XDG_RUNTIME_DIR']) / parent_socket
+        self.env = dict(self.parent, XDG_RUNTIME_DIR=str(self.root), WAYLAND_DISPLAY=str(parent_socket),
+                        XDG_CONFIG_HOME=str(self.root/'config'), XDG_CACHE_HOME=str(self.root/'cache'),
+                        XDG_DATA_HOME=str(self.root/'data'),
+                        AQ_DRM_DEVICES='/dev/null', LIBSEAT_BACKEND='seatd', SEATD_SOCK='/nonexistent',
+                        GDK_BACKEND='wayland', QT_QPA_PLATFORM='wayland', HYPRLAND_SEAT='primary')
+        for key in ('DISPLAY', 'HYPRLAND_INSTANCE_SIGNATURE', 'WLR_BACKENDS'):
+            self.env.pop(key, None)
+
+    def __enter__(self):
+        subprocess.run(['hyprctl', 'eval', self.rule + '=hl.window_rule({name="caelestia-native-test",match={class="^aquamarine$"},workspace="special:native-test silent",no_initial_focus=true,no_focus=true,no_anim=true})'], env=self.parent, check=True, capture_output=True)
+        config = self.root/'hypr.lua'
+        config.write_text('hl.monitor({output="",mode="preferred",position="auto",scale=1})\n_G.nativebind=hl.bind("SUPER + s",function() hl.dispatch(hl.dsp.window.float()) end)\nhl.config({misc={disable_hyprland_logo=true,disable_splash_rendering=true}})\n')
+        try:
+            with (self.root/'compositor.log').open('w') as log:
+                self.process = subprocess.Popen(['dbus-run-session', '--', str(BINARY), '-c', str(config)], env=self.env, stdout=log, stderr=log)
+            deadline = time.monotonic() + 25
+            while time.monotonic() < deadline:
+                sockets = list((self.root/'hypr').glob('*/.socket.sock'))
+                displays = [p for p in self.root.glob('wayland-*') if not p.name.endswith('.lock')]
+                if sockets and displays and (sockets[0].parent/'hyprland.lock').exists():
+                    self.env['HYPRLAND_INSTANCE_SIGNATURE'] = sockets[0].parent.name
+                    self.env['WAYLAND_DISPLAY'] = str(displays[0])
+                    self.pid = int((sockets[0].parent/'hyprland.lock').read_text().splitlines()[0])
+                    break
+                if self.process.poll() is not None:
+                    raise RuntimeError((self.root/'compositor.log').read_text()[-6000:])
+                time.sleep(.1)
+            else:
+                raise RuntimeError('Private compositor did not start')
+            assert Path(self.env['WAYLAND_DISPLAY']).parent == self.root
+            assert Path(f'/proc/{self.pid}/exe').resolve() == BINARY.resolve()
+            if os.environ.get('NATIVE_TEST_HEADLESS') == '1':
+                self.ctl('output', 'create', 'headless', 'private-test')
+            deadline = time.monotonic() + 12
+            while time.monotonic() < deadline:
+                if self.ctl_json('monitors', '-j'):
+                    # Wait for the parent Wayland configure, not the temporary 1280x720 mode.
+                    time.sleep(.4)
+                    # Pin the private primary output. Leaving it at "auto"
+                    # allows adding a headless output to move it underneath
+                    # already mapped test windows, depending on the parent.
+                    primary = self.ctl_json('monitors', '-j')[0]
+                    self.ctl('eval', 'hl.monitor({output='+json.dumps(primary['name'])+',mode="preferred",position="0x0",scale=1})')
+                    settle = time.monotonic() + 5
+                    while time.monotonic() < settle:
+                        output = self.ctl_json('monitors', '-j')[0]
+                        if output['x'] == 0 and output['y'] == 0:
+                            break
+                        time.sleep(.05)
+                    else:
+                        raise RuntimeError('Private primary output layout did not settle')
+                    return self
+                time.sleep(.1)
+            raise RuntimeError('Private output did not appear')
+        except BaseException:
+            self.close()
+            raise
+
+    def ctl(self, *args):
+        result = subprocess.run(['hyprctl', *args], env=self.env, capture_output=True, text=True, timeout=10, check=True)
+        return result.stdout
+
+    def ctl_json(self, *args):
+        return json.loads(self.ctl(*args))
+
+    def spawn(self, command, *, env=None, pipes=False):
+        assert Path(self.env['WAYLAND_DISPLAY']).parent == self.root
+        child_env = dict(self.env)
+        child_env.update(env or {})
+        if pipes:
+            child = subprocess.Popen(command, env=child_env, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=(self.root/f'child-{len(self.children)}.log').open('w'), text=True, bufsize=1)
+        else:
+            with (self.root/f'child-{len(self.children)}.log').open('w') as log:
+                child = subprocess.Popen(command, env=child_env, stdout=log, stderr=log)
+        self.children.append(child)
+        return child
+
+    def close(self):
+        for child in reversed(self.children):
+            if child.poll() is None:
+                child.terminate()
+                try:
+                    child.wait(timeout=4)
+                except subprocess.TimeoutExpired:
+                    child.kill()
+                    child.wait(timeout=4)
+        if not self.pid:
+            locks = list((self.root/'hypr').glob('*/hyprland.lock'))
+            if locks:
+                self.pid = int(locks[0].read_text().splitlines()[0])
+        if self.pid:
+            try:
+                if Path(f'/proc/{self.pid}/exe').resolve() == BINARY.resolve():
+                    os.kill(self.pid, signal.SIGTERM)
+            except (ProcessLookupError, FileNotFoundError):
+                pass
+        if self.process:
+            try:
+                self.process.wait(timeout=12)
+            except subprocess.TimeoutExpired:
+                self.process.terminate()
+                self.process.wait(timeout=5)
+        subprocess.run(['hyprctl', 'eval', f'if {self.rule} then {self.rule}:set_enabled(false) end'], env=self.parent, capture_output=True)
+
+    def __exit__(self, *_):
+        self.close()
