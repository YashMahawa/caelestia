#!/usr/bin/env bash
set -u

IPC_TIMEOUT=4
LOCK_RETRIES=2

SESSION_ID=""
USER_NAME=""
USER_ID=""

while read -r candidate _; do
    [ -n "$candidate" ] || continue
    active="$(/usr/bin/loginctl show-session "$candidate" -p Active --value 2>/dev/null || true)"
    remote="$(/usr/bin/loginctl show-session "$candidate" -p Remote --value 2>/dev/null || true)"
    type="$(/usr/bin/loginctl show-session "$candidate" -p Type --value 2>/dev/null || true)"
    if [ "$active" = yes ] && [ "$remote" = no ] && { [ "$type" = wayland ] || [ "$type" = x11 ]; }; then
        SESSION_ID="$candidate"
        USER_ID="$(/usr/bin/loginctl show-session "$candidate" -p User --value)"
        USER_NAME="$(/usr/bin/loginctl show-session "$candidate" -p Name --value)"
        break
    fi
done <<EOF
$(/usr/bin/loginctl list-sessions --no-legend 2>/dev/null || true)
EOF

# Sleep can be requested while only the display manager is running.
[ -n "$SESSION_ID" ] && [ -n "$USER_ID" ] && [ -n "$USER_NAME" ] || exit 0

USER_HOME="$(/usr/bin/getent passwd "$USER_ID" | /usr/bin/cut -d: -f6)"
RUNTIME_DIR="/run/user/${USER_ID}"
BUS="unix:path=${RUNTIME_DIR}/bus"
IPC="${USER_HOME}/.local/bin/caelestia-qs-ipc"
LOG="${RUNTIME_DIR}/caelestia-sleep-guard.log"

log() {
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >> "$LOG" 2>/dev/null || true
}

run_user() {
    /usr/bin/setpriv --reuid="$USER_ID" --regid="$USER_ID" --init-groups \
        /usr/bin/env \
        HOME="$USER_HOME" \
        USER="$USER_NAME" \
        LOGNAME="$USER_NAME" \
        XDG_RUNTIME_DIR="$RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$BUS" \
        "$@"
}

qs_call() {
    run_user /usr/bin/timeout "$IPC_TIMEOUT" "$IPC" "$@"
}

lock_session() {
    local attempt check
    for attempt in $(seq 1 "$LOCK_RETRIES"); do
        if qs_call lock safeLock >> "$LOG" 2>&1; then
            for check in $(seq 1 10); do
                if qs_call lock isLocked 2>/dev/null | /usr/bin/grep -qx true; then
                    log "lock: Caelestia session locked on attempt ${attempt}"
                    return 0
                fi
                /usr/bin/sleep 0.2
            done
        fi
        log "lock: Caelestia session lock failed on attempt ${attempt}"
        /usr/bin/sleep 0.25
    done
    return 1
}

ensure_ipc() {
    qs_call drawers list >> "$LOG" 2>&1
}

case "${1:-}/${2:-}" in
    pre/*)
        log "pre-sleep: locking with Caelestia before suspend"
        if ! ensure_ipc; then
            log "pre-sleep: Quickshell IPC unavailable; not restarting it during suspend"
        elif ! lock_session; then
            log "pre-sleep: Caelestia lock did not confirm before suspend"
        fi
        ;;
    post/*)
        log "post-resume: checking Caelestia Quickshell IPC and lock state"
        /usr/bin/sleep 2
        if ! ensure_ipc; then
            log "post-resume: Quickshell IPC unavailable; restarting once after display stabilization"
            run_user /usr/bin/systemctl --user restart caelestia-quickshell.service >> "$LOG" 2>&1 || true
            /usr/bin/sleep 2
        fi
        if ! qs_call lock isLocked 2>/dev/null | /usr/bin/grep -qx true; then
            log "post-resume: lock not active; requesting it again"
            lock_session >> "$LOG" 2>&1 || true
        fi
        log "post-resume: preserving compositor monitor layout to avoid output teardown races"
        ;;
esac
