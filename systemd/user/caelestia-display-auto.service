[Unit]
Description=Caelestia automatic single-display policy
After=graphical-session.target hyprland-session-anchor.service
Wants=hyprland-session-anchor.service
PartOf=graphical-session.target
Before=caelestia-quickshell.service

[Service]
Type=simple
ExecStart=%h/.local/bin/caelestia-display watch
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
