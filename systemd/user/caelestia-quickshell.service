[Unit]
Description=Caelestia Quickshell
After=graphical-session.target hyprland-session-anchor.service caelestia-display-auto.service
Wants=hyprland-session-anchor.service caelestia-display-auto.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=%h/.local/bin/caelestia-display auto
ExecStartPre=%h/.local/bin/caelestia-qs-clean-runtime
ExecStart=%h/.local/bin/caelestia-qs-launch
ExecStartPost=%h/.local/bin/caelestia-lock-recover
ExecStop=qs kill -c caelestia
Restart=on-failure
RestartSec=500ms

[Install]
WantedBy=default.target
